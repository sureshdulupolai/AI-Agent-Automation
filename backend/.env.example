# =========================================================
# OmniBot SaaS - Environment Configuration
# =========================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=omnibot-super-secret-jwt-key-2026

# Google Gemini Free API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# ---------------------------------------------------------
# DATABASE TOGGLE:
# Set USE_SUPABASE=false for Local Embedded Database (Testing / Offline)
# Set USE_SUPABASE=true for Supabase PostgreSQL Cloud Database (Production)
# ---------------------------------------------------------
USE_SUPABASE=false

# Supabase PostgreSQL Credentials (Required only when USE_SUPABASE=true)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Meta WhatsApp Cloud API (Optional: free 1,000 convos/month)
META_VERIFY_TOKEN=omnibot_verify_token_2026
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
