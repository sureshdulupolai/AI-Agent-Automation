# =========================================================
# OmniBot SaaS - Root .gitignore
# =========================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment Variables & All Env files
.env
.env*
*.env
*.env.*
.env.example
backend/.env
backend/.env.example
frontend/.env
frontend/.env.example

# WhatsApp Live Session Credentials & Auth Tokens (Do NOT commit sensitive WhatsApp keys)
backend/data/whatsapp_sessions/
backend/data/test_wa_session/
*.session
*.session-journal

# AI API Keys & Secret Pools (Do NOT commit secrets to GitHub)
backend/data/gemini_keys.json
gemini_keys.json
backend/data/google_tokens.json
google_tokens.json
backend/data/campaigns.json
backend/data/email_automations*.json

# Production Builds
frontend/dist/
frontend/build/
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & OS Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary & Cache
.cache/
.eslintcache
.vite/
